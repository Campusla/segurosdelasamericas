          <label for="lead-city">Ciudad *</label>
          <input type="text" id="lead-city" placeholder="Ej: Bogotá / Tunja / Duitama" required>
        </div>

        <button type="submit" class="btn-submit-lead">
          📱 Enviar Cotización por WhatsApp
        </button>
      </form>
    </div>
  </div>

  <!-- JAVASCRIPT INTERACTIVO -->
  <script>
    function openQuoteModal(productName) {
      document.getElementById('selected-product').value = productName;
      document.getElementById('modal-product-title').innerText = 'Cotizar: ' + productName;
      document.getElementById('modal-cotizacion').style.display = 'flex';
    }

    function closeQuoteModal() {
      document.getElementById('modal-cotizacion').style.display = 'none';
    }

    function submitToWhatsApp(e) {
      e.preventDefault();
      const product = document.getElementById('selected-product').value;
      const name = document.getElementById('lead-name').value;
      const phone = document.getElementById('lead-phone').value;
      const city = document.getElementById('lead-city').value;

      const agentNumber = "573112306647"; // Número extraído de su sitio oficial
      const message = `Hola, Seguros de las Américas 👋%0AMi nombre es *${name}* y deseo solicitar una cotización de *${product}*.%0A%0A📍 *Ciudad:* ${city}%0A📱 *Contacto:* ${phone}%0A%0AQuedo atento a las opciones disponibles.`;

      window.open(`https://wa.me/${agentNumber}?text=${message}`, '_blank');
      closeQuoteModal();
    }

    window.onclick = function(event) {
      if (event.target.classList.contains('modal-overlay')) {
        closeQuoteModal();
      }
    }
  </script>

</body>
</html>
